{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/assets/:path*", "destination": "/web/assets/:path*" },
    { "source": "/app.js", "destination": "/web/app.js" },
    { "source": "/styles.css", "destination": "/web/styles.css" },
    { "source": "/", "destination": "/web/index.html" }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{.venv/**,__pycache__/**,chrome-profile/**,chrome-profile-rubinot/**,chrome-extension/**,*.log,*.zip,xp_data.json,bot.*.log,web.*.log}"
    }
  }
}
